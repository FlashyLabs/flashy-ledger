{
  "name": "@flashy/ledger",
  "version": "0.1.0",
  "description": "Append-only, multi-asset settlement ledger. Storage-agnostic by construction.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist-cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    }
  },
  "files": [
    "dist",
    "dist-cjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && node scripts/stamp-cjs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "check": "npm run typecheck && npm run lint && npm run coverage",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "mongodb": "^6.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "mongodb": "^6.21.0 || ^7.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlashyLabs/flashy-ledger.git"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    }
  },
  "module": "./dist/index.js"
}
